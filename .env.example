# === Runtime mode ===
# PAPER_MODE=true (default) — simulated fills only, no wallet keys needed
PAPER_MODE=true

# Optional: load a JSON preset instead of config/default.json (env still wins)
# CONFIG_FILE=config/pumpfun-preset.json

# === In-app presets / runtime overlay (paper only) ===
# Named presets via POST /config/preset { "preset": "momentum" | "sniper" }
#   momentum = Pump.fun research defaults (see README)
#   sniper   = newer coins OK, lower age/liq, 8% stop, lower TP / faster trail
# PATCH /config persists paper knobs to data/runtime-config.json (survives restart).
# Overlay wins over file/env for those knobs. Live / wallet fields are rejected.
# RUNTIME_CONFIG_FILE=runtime-config.json

# === Capital & risk ===
BANKROLL_USD=20
MAX_OPEN_TRADES=1
STOP_LOSS_PCT=10
# Hard take-profit: exit when unrealized gain ≥ this % (0 = off; default 25)
TAKE_PROFIT_PCT=25
# Exit open paper position after this many minutes (0 = off)
MAX_HOLD_MINUTES=20
# Stop runner when session realized PnL ≤ −this USD (0 = off)
# Daily loss is session realized vs a fixed USD cap — not growing equity.
DAILY_LOSS_USD=5
# After FULL loss of original deposit (BANKROLL_USD), lock trading this many hours.
# Persisted on laptop/API (data/chase-lockout.json). Reset does NOT unlock (timer only).
# 0 = disable chase lockout. Default 12. Paper preview for future live.
CHASE_LOCKOUT_HOURS=12

# === Position sizing ===
# Fraction of available (tradable) cash to deploy per entry (0.95 = keep ~5% cash buffer)
# Tradable cash excludes the skim vault — see POST /vault/skim
POSITION_SIZE_PCT=0.95
# Hard USD cap per open trade (0 = off). Sticky across presets. Default 25 for ~$100 bankroll.
MAX_POSITION_USD=25

# === Momentum entry (short-window strength) ===
# Min % price change over MOMENTUM_WINDOW_MINUTES to consider entry
MOMENTUM_MIN_PCT=8
MOMENTUM_WINDOW_MINUTES=5
# Volume must be at least this multiple of recent average
VOLUME_SPIKE_MULT=2.0
# Skip tokens with liquidity below this (USD)
MIN_LIQUIDITY_USD=15000
# Skip tokens with 24h volume below this (USD)
MIN_VOLUME_24H_USD=25000
# Skip coins younger than this many minutes when createdAt is known (0 = off)
MIN_AGE_MINUTES=3

# === Trailing take-profit ===
# Activate trail only after unrealized gain reaches this %
TRAIL_ACTIVATE_PCT=15
# Once active, exit if price falls this % from the high-water mark
TRAIL_DISTANCE_PCT=5

# === Paper broker simulation ===
SLIPPAGE_BPS=50
FEE_BPS=30
# Loop interval (ms) between market scans
POLL_INTERVAL_MS=15000
# Max tokens to evaluate per scan (mock / DexScreener / pumpfun)
SCAN_LIMIT=20

# === Data source ===
# mock | dexscreener | pumpfun
# mock = deterministic synthetic prices (good for tests / offline)
# dexscreener = public free API (no key); rate-limited
# pumpfun = Pump.fun frontend listings (unofficial) + optional DexScreener enrich/fallback
#           PAPER fills only — live Pump.fun/Jupiter swaps still stubbed (no wallet keys)
MARKET_DATA_SOURCE=mock
# Hard timeout (ms) for each Pump.fun / DexScreener HTTP call (default 8000).
# Prevents a hung Cloudflare/Dex socket from wedging the maxOpen=1 runner for hours.
# MARKET_HTTP_TIMEOUT_MS=8000
# While in a position, exit checks use a shorter Dex refresh (2s) when a cache
# mark exists, poll at most every 3s, and skip the entry scan (maxOpen=1).

# --- Pump.fun paper preset (copy or use CONFIG_FILE=config/pumpfun-preset.json) ---
# MARKET_DATA_SOURCE=pumpfun
# MOMENTUM_MIN_PCT=5
# MIN_LIQUIDITY_USD=5000
# MIN_VOLUME_24H_USD=8000
# MIN_AGE_MINUTES=3
# TRAIL_ACTIVATE_PCT=10
# TRAIL_DISTANCE_PCT=7
# TAKE_PROFIT_PCT=25
# MAX_HOLD_MINUTES=20
# DAILY_LOSS_USD=5
# PUMPFUN_API_BASE=https://frontend-api-v3.pump.fun
# PUMPFUN_DEXSCREENER_ENRICH=true
# PUMPFUN_DEXSCREENER_FALLBACK=true

# Optional: Birdeye / Jupiter keys if you wire live later (NOT required for paper)
# BIRDEYE_API_KEY=
# JUPITER_API_KEY=

# Live mode stubs — leave unset for paper. This bot still refuses live mode.
# LIVE_RPC_URL=
# LIVE_WALLET_KEYPAIR_PATH=

# Optional READ-ONLY Solana JSON-RPC (account info, signatures, transactions,
# token largest accounts). Unset = today's behavior: paper loop uses pump.fun
# HTTP and does not call an RPC. Never a wallet key. The URL is not shown on
# /status or /config (only solanaRpcConfigured: true/false).
# Not used to send or sign transactions.
# SOLANA_RPC_URL=

# Optional READ-ONLY Solana JSON-RPC WebSocket (listen only).
# Paste your RPC Fast (or other) WSS URL here. Dedicated env — do not reuse
# SOLANA_RPC_URL. Unset = no WSS; paper stays HTTPS/poll as today.
# When set: connects, slotSubscribe, and can account/logs-subscribe (e.g. pinned
# mint). Lookups + rug checks + future trade sends stay on HTTPS.
# /status shows solanaRpcWss { configured, connected, state, lastSlot, … }
# and never the URL. Reconnects with backoff; if WSS drops, paper keeps polling.
# Not used to send or sign transactions. Live trading stays stubbed.
# SOLANA_RPC_WSS_URL=

# === Pre-buy rug filter (paper only, default OFF) ===
# OFF = today's behavior. No RPC calls for this filter.
# ON without SOLANA_RPC_URL = that paper buy is skipped (fail closed).
# Does not send a trade. Does not change momentum, poll, bankroll, or exits.
# RUG_FILTER_ENABLED=false
# Reject when the largest non-curve holder is ABOVE this % of supply (30 = default).
# RUG_FILTER_MAX_TOP_HOLDER_PCT=30
# Reject when MORE THAN this many other txs share the creation slot (3 = default).
# RUG_FILTER_MAX_SAME_SLOT_BUYS=3
# Not implemented: dev rug history, wash volume. Those are logged and skipped,
# not treated as a silent pass. See docs/rug-filter.md.

# === Control API (mobile / LAN UI) ===
# npm run api  — HTTP server; runner starts STOPPED until POST /runner/start
# API_HOST=0.0.0.0
# API_PORT=8787
# CONTROL_API=true

# === Research checklist (human go/no-go) ===
# When true, paper entries require a saved checklist with verdict GO for that mint.
# Default false — checklist is advisory only (app Check tab). Also PATCH /config.
# REQUIRE_CHECKLIST_GO=false

# Optional: force SOL/USD (or chain quote) rate for journal dual display.
# When unset, Pump.fun / DexScreener / mock provide getQuoteUsdRate().
# SOL_USD_RATE=150
# QUOTE_USD_RATE=150
