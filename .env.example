# === Runtime mode ===
# PAPER_MODE=true (default) — simulated fills only, no wallet keys needed
PAPER_MODE=true

# Optional: load a JSON preset instead of config/default.json (env still wins)
# CONFIG_FILE=config/pumpfun-preset.json

# === In-app presets / runtime overlay (paper only) ===
# Named presets via POST /config/preset { "preset": "momentum" | "sniper" }
#   momentum = Pump.fun research defaults (see README)
#   sniper   = newer coins OK, lower age/liq, 8% stop, lower TP / faster trail
# PATCH /config persists paper knobs to data/runtime-config.json (survives restart).
# Overlay wins over file/env for those knobs. Live / wallet fields are rejected.
# RUNTIME_CONFIG_FILE=runtime-config.json

# === Capital & risk ===
BANKROLL_USD=20
MAX_OPEN_TRADES=1
STOP_LOSS_PCT=10
# Hard take-profit: exit when unrealized gain ≥ this % (0 = off; default 25)
TAKE_PROFIT_PCT=25
# Exit open paper position after this many minutes (0 = off)
MAX_HOLD_MINUTES=20
# Stop runner when session realized PnL ≤ −this USD (0 = off)
# Daily loss is session realized vs a fixed USD cap — not growing equity.
DAILY_LOSS_USD=5
# After FULL loss of original deposit (BANKROLL_USD), lock trading this many hours.
# Persisted on laptop/API (data/chase-lockout.json). Reset does NOT unlock (timer only).
# HARD daily loss limit (paper, dry-run AND live). Hardcoded ceiling $300 — this can
# only LOWER it. It cannot be disabled: 0, negative, text or >300 all become 300.
# Counts today's (ET) closed P&L + losses on open coins. When hit: no new buys,
# open coins still managed, locked until midnight ET. Reset/restart don't clear it.
# HARD_DAILY_LOSS_USD=300
# 0 = disable chase lockout. Default 12. Paper preview for future live.
CHASE_LOCKOUT_HOURS=12

# === Position sizing ===
# Legacy: no longer sizes buys. Every new buy is exactly the selected trade size
# ($15/$30/$60 buttons); if tradable cash (excludes the skim vault) can't cover the
# full size, buying pauses with a plain message in /status — never a smaller buy.
POSITION_SIZE_PCT=0.95
# Hard USD cap per open trade (0 = off). Sticky across presets. Default 25 for ~$100 bankroll.
MAX_POSITION_USD=25

# === Momentum entry (short-window strength) ===
# Min % price change over MOMENTUM_WINDOW_MINUTES to consider entry
MOMENTUM_MIN_PCT=8
MOMENTUM_WINDOW_MINUTES=5
# Volume must be at least this multiple of recent average
VOLUME_SPIKE_MULT=2.0
# Skip tokens with liquidity below this (USD)
MIN_LIQUIDITY_USD=15000
# Skip tokens with 24h volume below this (USD)
MIN_VOLUME_24H_USD=25000
# Skip coins younger than this many minutes when createdAt is known (0 = off)
MIN_AGE_MINUTES=3

# === Trailing take-profit ===
# Activate trail only after unrealized gain reaches this %
TRAIL_ACTIVATE_PCT=15
# Once active, exit if price falls this % from the high-water mark
TRAIL_DISTANCE_PCT=5

# === Paper trading costs (realistic by default) ===
# Paper P&L is always NET of these. Defaults match today's documented rates
# (sources in docs/paper-fees.md). A $15 round trip on the bonding curve costs
# about $0.74 in fees at SOL ≈ $116 (≈ 5%), plus a little slippage.
#
# LIVE DRY-RUN (practice mode) uses the same model for its estimates.
# realistic = itemised costs below. legacy = old flat FEE_BPS + SLIPPAGE_BPS
# (and dry-run's old PumpPortal 0.5% + priority-fee estimate).
PAPER_FEE_MODEL=realistic
# pump.fun bonding-curve trading fee per buy AND per sell (bps). 125 = 1.25%.
PAPER_PUMP_FEE_BPS=125
# Graduated coins (PumpSwap). Blank/"tiered" = pump.fun's official market-cap
# tier table (1.25% for small coins down to 0.30%). Or a flat number in bps.
PAPER_PUMPSWAP_FEE_BPS=
# PumpPortal Local API fee per buy AND per sell (bps). 50 = 0.5%.
# Set 0 if you'd trade directly / not through PumpPortal.
PAPER_PUMPPORTAL_FEE_BPS=50
# Solana network: base fee + priority fee per transaction (SOL).
# Priority fee defaults to LIVE_PRIORITY_FEE_SOL when set, else 0.0002.
PAPER_BASE_FEE_SOL=0.000005
# PAPER_PRIORITY_FEE_SOL=0.0002
# New token account rent per coin bought (SOL). Counted as a cost because
# sells don't close the account, so it is never refunded. 0.00148844 is the
# live mainnet value (Oct 2026, SIMD-0437 step 2). Solana plans further cuts
# (to ~0.0002 SOL) — lower this when they land.
PAPER_TOKEN_ACCOUNT_RENT_SOL=0.00148844
# Slippage (moves the fill price only — never double-counted as a fee).
# liquidity = PAPER_SLIPPAGE_BASE_BPS + (trade size ÷ pool liquidity), capped.
# flat      = SLIPPAGE_BPS on every trade.
PAPER_SLIPPAGE_MODEL=liquidity
PAPER_SLIPPAGE_BASE_BPS=25
PAPER_SLIPPAGE_MAX_BPS=300
# Flat slippage per side: used when pool liquidity is unknown, or in flat/legacy.
SLIPPAGE_BPS=50
# Venue to assume when market data doesn't say: bonding_curve | pumpswap
PAPER_DEFAULT_VENUE=bonding_curve
# SOL/USD used for SOL-priced costs if no live price is available.
PAPER_SOL_USD_FALLBACK=150
# Skip coins LIVE can't actually buy, so paper results match live (default true):
#  - coins paired with a non-SOL token (PUMP, USDC, tokenized stocks). PumpPortal
#    can only buy with SOL. Uses pump.fun's quote_mint / DexScreener's quote token.
#  - graduated coins whose PumpSwap pool has under ~29 SOL of real liquidity
#    (live skips these as too thin). Uses DexScreener's pool numbers.
# Uses only data the scan already fetched (no extra requests). A skipped coin is
# left alone for a while like live does (non-SOL pair 24h, thin pool 15 min;
# repeats double the wait). false = old behaviour (paper buys anything).
PAPER_SKIP_UNBUYABLE=true
# Legacy only (PAPER_FEE_MODEL=legacy): flat fee per side in bps.
# FEE_BPS=30
# Loop interval (ms) between market scans
POLL_INTERVAL_MS=15000
# Max tokens to evaluate per scan (mock / DexScreener / pumpfun)
SCAN_LIMIT=20

# === Data source ===
# mock | dexscreener | pumpfun
# mock = deterministic synthetic prices (good for tests / offline)
# dexscreener = public free API (no key); rate-limited
# pumpfun = Pump.fun frontend listings (unofficial) + optional DexScreener enrich/fallback
#           PAPER fills only — live Pump.fun/Jupiter swaps still stubbed (no wallet keys)
MARKET_DATA_SOURCE=mock
# Hard timeout (ms) for each Pump.fun / DexScreener HTTP call (default 8000).
# Prevents a hung Cloudflare/Dex socket from wedging the maxOpen=1 runner for hours.
# MARKET_HTTP_TIMEOUT_MS=8000
# While in a position, exit checks use a shorter Dex refresh (2s) when a cache
# mark exists, poll at most every 3s, and skip the entry scan (maxOpen=1).

# --- Pump.fun paper preset (copy or use CONFIG_FILE=config/pumpfun-preset.json) ---
# MARKET_DATA_SOURCE=pumpfun
# MOMENTUM_MIN_PCT=5
# MIN_LIQUIDITY_USD=5000
# MIN_VOLUME_24H_USD=8000
# MIN_AGE_MINUTES=3
# TRAIL_ACTIVATE_PCT=10
# TRAIL_DISTANCE_PCT=7
# TAKE_PROFIT_PCT=25
# MAX_HOLD_MINUTES=20
# DAILY_LOSS_USD=5
# PUMPFUN_API_BASE=https://frontend-api-v3.pump.fun
# PUMPFUN_DEXSCREENER_ENRICH=true
# PUMPFUN_DEXSCREENER_FALLBACK=true

# Optional: Birdeye / Jupiter keys if you wire live later (NOT required for paper)
# BIRDEYE_API_KEY=
# JUPITER_API_KEY=

# Live mode stubs — leave unset for paper. This bot still refuses live mode.
# LIVE_RPC_URL=
# LIVE_WALLET_KEYPAIR_PATH=

# Optional READ-ONLY Solana JSON-RPC (account info, signatures, transactions,
# token largest accounts). Unset = today's behavior: paper loop uses pump.fun
# HTTP and does not call an RPC. Never a wallet key. The URL is not shown on
# /status or /config (only solanaRpcConfigured: true/false).
# Not used to send or sign transactions.
# SOLANA_RPC_URL=

# Optional READ-ONLY Solana JSON-RPC WebSocket (listen only).
# Paste your RPC Fast (or other) WSS URL here. Dedicated env — do not reuse
# SOLANA_RPC_URL. Unset = no WSS; paper stays HTTPS/poll as today.
# When set: connects, slotSubscribe, and can account/logs-subscribe (e.g. pinned
# mint). Lookups + rug checks + future trade sends stay on HTTPS.
# /status shows solanaRpcWss { configured, connected, state, lastSlot, … }
# and never the URL. Reconnects with backoff; if WSS drops, paper keeps polling.
# Not used to send or sign transactions. Live trading stays stubbed.
# SOLANA_RPC_WSS_URL=

# === Pre-buy rug filter (paper: default OFF; live: always on) ===
# OFF = today's behavior. No RPC calls for this filter.
# ON without SOLANA_RPC_URL = that paper buy is skipped (fail closed).
# Does not send a trade. Does not change momentum, poll, bankroll, or exits.
# RUG_FILTER_ENABLED=false
# Reject when the largest non-curve holder is ABOVE this % of supply (30 = default).
# RUG_FILTER_MAX_TOP_HOLDER_PCT=30
# Reject when MORE THAN this many other txs share the creation slot (3 = default).
# RUG_FILTER_MAX_SAME_SLOT_BUYS=3
# Graduated (PumpSwap) coins — always checked when the filter runs (live: always).
# The canonical PumpSwap pool's token vault is the ONLY holder excluded (plus the
# burn address and leftover pump.fun curve accounts). Can't read the pool or
# holders = skip the buy (fail closed).
# Skip if the pool holds LESS than this % of supply. Graduation starts ~20%; it
# falls as price rises. TRUMPSI 5.4% / BUNKER 4.2% at our buys. 0 = off.
# RUG_FILTER_GRAD_MIN_POOL_PCT=10
# Skip if any one wallet outside the pool holds MORE than this % (both incident
# coins had a 13.5% wallet; the old 30% check passed them).
# RUG_FILTER_GRAD_MAX_HOLDER_PCT=10
# Skip if the 10 largest wallets outside the pool hold MORE than this % together.
# RUG_FILTER_GRAD_MAX_TOP10_PCT=35
# A failed check sticks to that coin this long, so a later re-check can't flip
# it to a pass (RPC errors stick only 2 min). 0 = no memory.
# RUG_FILTER_FAIL_COOLDOWN_MINUTES=60
# Not implemented: dev rug history, wash volume. Those are logged and skipped,
# not treated as a silent pass. See docs/rug-filter.md.

# === Fast exits while holding ===
# While a position is open, read that coin's bonding curve (or PumpSwap pool,
# once graduated) straight from SOLANA_RPC_URL this often (ms) and run
# take-profit / trailing / stop on it — a hit sells right away. One read-only
# HTTPS request per held coin per tick (no WebSocket subscription is added).
# DexScreener's price can trail the chain by 10-60s; it stays the fallback.
# 0 = off (old behaviour: Dex price every ~3s). No SOLANA_RPC_URL = off.
# FAST_EXIT_POLL_MS=1000

# === Control API (mobile / LAN UI) ===
# npm run api  — HTTP server; runner starts STOPPED until POST /runner/start
# API_HOST=0.0.0.0
# API_PORT=8787
# CONTROL_API=true

# === Research checklist (human go/no-go) ===
# When true, paper entries require a saved checklist with verdict GO for that mint.
# Default false — checklist is advisory only (app Check tab). Also PATCH /config.
# REQUIRE_CHECKLIST_GO=false

# Optional: force SOL/USD (or chain quote) rate for journal dual display.
# When unset, Pump.fun / DexScreener / mock provide getQuoteUsdRate().
# SOL_USD_RATE=150
# QUOTE_USD_RATE=150

# =====================================================================
# === LIVE TRADING (opt-in). Leave this whole block alone for paper. ===
# =====================================================================
# Live needs ALL THREE gates below. Missing any one → PAPER (the default).
# PAPER_MODE=false
# LIVE_TRADING_ENABLED=false
# LIVE_CONFIRM=I_UNDERSTAND
#
# Dry-run builds + simulates every trade but NEVER sends. Only the exact word
# "false" turns it off. Keep it true until you've watched it work.
# LIVE_DRY_RUN=true
#
# Path to a Solana CLI keypair FILE on this machine (chmod 600). Never paste a
# key here or anywhere else. Use a NEW wallet funded with only the trading stake.
# LIVE_WALLET_KEYPAIR_PATH=/home/<your-user>/bot-wallet.json
#
# Live uses SOLANA_RPC_URL (HTTPS) to simulate/send/confirm. Required for live.
# SOLANA_RPC_URL=https://<your-rpc-provider>/<your-key>
#
# --- Live hard caps (separate from paper settings; env only) ---
# Max USD per live buy (default 60 so all trade-size buttons work; lower it to block bigger buttons)
# LIVE_MAX_POSITION_USD=60
# Max coins held at once (default 1)
# LIVE_MAX_OPEN_POSITIONS=1
# Live daily loss limit (default 300). Can only LOWER the hard $300 ceiling;
# 0 / negative / text / >300 all clamp to 300.
# LIVE_DAILY_LOSS_LIMIT_USD=300
# Always keep this much SOL for fees / token accounts (default 0.05)
# LIVE_MIN_SOL_RESERVE=0.05
#
# --- Execution ---
# Buy slippage in basis points (1500 = 15%; pump.fun coins move fast)
# LIVE_SLIPPAGE_BPS=1500
# Sell retries escalate slippage up to this cap (default 4000 = 40%)
# LIVE_SELL_MAX_SLIPPAGE_BPS=4000
# LIVE_SELL_MAX_ATTEMPTS=4
# Priority fee in SOL per tx, and the hard cap it can never exceed
# LIVE_PRIORITY_FEE_SOL=0.0002
# LIVE_PRIORITY_FEE_MAX_SOL=0.001
# Confirmation polling over HTTPS
# LIVE_CONFIRM_TIMEOUT_MS=60000
# LIVE_CONFIRM_POLL_MS=1500
# PumpPortal pool: auto | pump | pump-amm | raydium (default auto).
# With auto, coins pump.fun reports as graduated are sent to PumpSwap (pump-amm)
# directly, and a curve buy refused with "BondingCurveComplete" gets ONE retry on
# PumpSwap (only after a failed simulation, so nothing is ever sent twice).
# PumpSwap buys correct PumpPortal's quote on "boost" pools (it ignores the
# pool's virtual SOL and asks for too many tokens): the request is resized so
# the SOL cap stays exactly amount x (1 + LIVE_SLIPPAGE_BPS). Max spend never
# goes up. Pools with under ~29 SOL of real liquidity are skipped.
# After a failed buy the coin is skipped for a while (in memory, restart clears):
# slippage 10 min, just graduated 5 min, thin pool 15 min, other 5 min,
# PumpPortal HTTP 400 6h, non-SOL pair (PUMP/USDC/stock-paired coins) 24h,
# sent-but-unconfirmed 60 min. Repeats double the wait (max 24h).
# LIVE_POOL=auto
#
# --- Vault sweep (LIVE only) ---
# PUBLIC address of a SECOND wallet that receives skimmed profit as SOL.
# Public address only — NEVER a private key or keypair file. Must not be the bot wallet.
# Only changeable here (then restart); no API or phone action can change it.
# Unset → vault stays bookkeeping only, even in live.
# LIVE_VAULT_ADDRESS=<your-vault-wallet-PUBLIC-address>
# Sweep automatically after each skim (default true when the address is set)
# LIVE_VAULT_AUTO_SWEEP=true
# Don't sweep less than this (avoids fee spam). Default 0.05 SOL.
# LIVE_VAULT_MIN_SWEEP_SOL=0.05
# Failed sweeps retry up to this many times, then pause + alert (default 5)
# LIVE_VAULT_MAX_ATTEMPTS=5
